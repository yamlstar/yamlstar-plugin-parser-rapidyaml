#!/usr/bin/env bash

set -euo pipefail

command=${1:-list}
old_version=${2:-${OLD_VERSION:-}}
new_version=${3:-${NEW_VERSION:-}}
perl=${PERL:?PERL must name the project-managed Perl}
gh=${GH:-gh}
release_repo=${RELEASE_REPO:-yamlstar/yamlstar-plugin-parser-rapidyaml}
release_workflow=${RELEASE_WORKFLOW:-release.yaml}
dry_run=${YS_RELEASE_DRYRUN:-}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

require_new_version() {
  [[ -n $new_version ]] || die 'A new version is required'
  [[ $new_version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] ||
    die "Invalid version: $new_version"
}

manifest_version() {
  # The dollar signs below are Perl variables, not shell expansions.
  # shellcheck disable=SC2016
  "$perl" -ne 'print "$1\n" if /:version "([^"]+)"/' plugin.edn
}

make_version() {
  # The dollar signs below are Perl variables, not shell expansions.
  # shellcheck disable=SC2016
  "$perl" -ne 'print "$1\n" if /^VERSION := (\S+)/' Makefile
}

abi_version() {
  # The dollar signs below are Perl variables, not shell expansions.
  # shellcheck disable=SC2016
  "$perl" -ne \
    'print "$1\n" if /^#define PLUGIN_VERSION "([^"]+)"/' \
    test/abi.c
}

adapter_version() {
  # shellcheck disable=SC2016
  "$perl" -ne 'print "$1\n" if /^const Version = "([^"]+)"/' \
    goyaml/plugin.go
}

current_version() {
  local manifest makefile abi adapter
  manifest=$(manifest_version)
  makefile=$(make_version)
  abi=$(abi_version)
  adapter=$(adapter_version)
  [[ -n $manifest ]] || die 'No version found in plugin.edn'
  [[ $manifest == "$makefile" ]] ||
    die "Makefile version $makefile does not match plugin.edn $manifest"
  [[ $manifest == "$abi" ]] ||
    die "ABI test version $abi does not match plugin.edn $manifest"
  [[ $manifest == "$adapter" ]] ||
    die "Adapter version $adapter does not match plugin.edn $manifest"
  printf '%s\n' "$manifest"
}

tag_points_to_head() {
  local version=$1 tag
  for tag in "$version" "v$version"; do
    git rev-parse "$tag" >/dev/null 2>&1 ||
      die "Tag $tag does not exist"
    [[ $(git rev-parse "$tag^{commit}") == $(git rev-parse HEAD) ]] ||
      die "Tag $tag does not point to HEAD"
  done
}

confirm() {
  local prompt=$1
  local answer
  read -r -p "$prompt [Y/n] " answer || return 1
  [[ -z $answer || $answer =~ ^[Yy]$ ]]
}

do_list() {
  cat <<'EOF'
RapidYAML Plugin Release Process
====================================

Publish the already-versioned release:
  make release v=0.1.2

Run a complete version-bump release:
  make release o=0.1.2 v=0.1.3

Preview either workflow without changing anything:
  make release o=0.1.2 v=0.1.3 d=1

Individual steps:
  make release-sanity-check o=OLD_VERSION v=NEW_VERSION
  make release-version-bump o=OLD_VERSION v=NEW_VERSION
  make release-pull
  make release-commit v=NEW_VERSION
  make release-tag v=NEW_VERSION
  make release-push v=NEW_VERSION
  make release-build-github v=NEW_VERSION
  make release-retry v=VERSION

Set a=1 to allow a release from a branch other than main.
EOF
}

do_sanity_check() {
  require_new_version

  local current branch
  current=$(current_version)
  old_version=${old_version:-$current}

  [[ $current == "$old_version" ]] ||
    die "Current version $current does not match old version $old_version"

  branch=$(git branch --show-current)
  if [[ -z $dry_run && -z ${YS_RELEASE_ALLOW_BRANCH:-} ]]; then
    [[ $branch == main ]] ||
      die 'Releases require branch main; set a=1 to override'
  fi

  if [[ -z $dry_run && -n $(git status --porcelain) ]]; then
    git status --short >&2
    die 'Working tree is not clean'
  fi

  local tag
  for tag in "$new_version" "v$new_version"; do
    if git rev-parse "$tag" >/dev/null 2>&1; then
      [[ $(git rev-parse "$tag^{commit}") == $(git rev-parse HEAD) ]] ||
        die "Tag $tag already exists away from HEAD"
    fi
  done

  printf 'Current version: %s\n' "$current"
  printf 'Release version: %s\n' "$new_version"
  printf 'Release branch: %s\n' "$branch"
  printf 'All sanity checks passed\n'
}

do_version_bump() {
  require_new_version

  local current
  current=$(current_version)
  old_version=${old_version:-$current}
  [[ $current == "$old_version" ]] ||
    die "Current version $current does not match old version $old_version"

  if [[ $current == "$new_version" ]]; then
    printf 'Version is already %s\n' "$new_version"
    return
  fi

  if [[ -n $dry_run ]]; then
    printf 'Would bump version from %s to %s\n' \
      "$current" "$new_version"
    return
  fi

  # The dollar signs below are Perl variables, not shell expansions.
  # shellcheck disable=SC2016
  RELEASE_OLD=$current RELEASE_NEW=$new_version "$perl" -pi -e '
    BEGIN {
      $old = $ENV{RELEASE_OLD};
      $new = $ENV{RELEASE_NEW};
    }
    s/^VERSION := \Q$old\E$/VERSION := $new/;
  ' Makefile
  # shellcheck disable=SC2016
  RELEASE_OLD=$current RELEASE_NEW=$new_version "$perl" -pi -e '
    BEGIN {
      $old = $ENV{RELEASE_OLD};
      $new = $ENV{RELEASE_NEW};
    }
    s/^ :version "\Q$old\E"$/ :version "$new"/;
  ' plugin.edn
  # shellcheck disable=SC2016
  RELEASE_OLD=$current RELEASE_NEW=$new_version "$perl" -pi -e '
    BEGIN {
      $old = $ENV{RELEASE_OLD};
      $new = $ENV{RELEASE_NEW};
    }
    s/^#define PLUGIN_VERSION "\Q$old\E"$/#define PLUGIN_VERSION "$new"/;
  ' test/abi.c

  # shellcheck disable=SC2016
  RELEASE_OLD=$current RELEASE_NEW=$new_version "$perl" -pi -e '
    BEGIN {
      $old = $ENV{RELEASE_OLD};
      $new = $ENV{RELEASE_NEW};
    }
    s/^const Version = "\Q$old\E"$/const Version = "$new"/;
  ' goyaml/plugin.go

  [[ $(current_version) == "$new_version" ]] ||
    die 'Version bump did not update every version file'
  printf 'Bumped version from %s to %s\n' "$current" "$new_version"
  git status --short -- Makefile plugin.edn test/abi.c goyaml/plugin.go
}

do_commit() {
  require_new_version
  [[ $(current_version) == "$new_version" ]] ||
    die "Version files do not contain $new_version"

  if [[ -z $(git status --porcelain -- \
      Makefile plugin.edn test/abi.c goyaml/plugin.go) ]]; then
    printf 'No version changes to commit\n'
    return
  fi

  if [[ -n $dry_run ]]; then
    printf 'Would commit release version %s\n' "$new_version"
    return
  fi

  git add Makefile plugin.edn test/abi.c goyaml/plugin.go
  git commit \
    -m "Release plugin version $new_version" \
    -m "Update embedded manifest and build metadata for $new_version."
}

do_tag() {
  require_new_version
  [[ $(current_version) == "$new_version" ]] ||
    die "Version files do not contain $new_version"

  local tag
  # Check both tags before creating either of them.
  for tag in "$new_version" "v$new_version"; do
    if git rev-parse "$tag" >/dev/null 2>&1; then
      [[ $(git rev-parse "$tag^{commit}") == $(git rev-parse HEAD) ]] ||
        die "Tag $tag already exists away from HEAD"
    fi
  done
  for tag in "$new_version" "v$new_version"; do
    if git rev-parse "$tag" >/dev/null 2>&1; then
      printf 'Tag %s already points to HEAD\n' "$tag"
    elif [[ -n $dry_run ]]; then
      printf 'Would create tag %s\n' "$tag"
    else
      git tag "$tag"
      printf 'Created tag %s\n' "$tag"
    fi
  done
}

do_push() {
  require_new_version
  tag_points_to_head "$new_version"

  local branch
  branch=$(git branch --show-current)
  [[ -n $branch ]] || die 'Cannot release from detached HEAD'

  if [[ -n $dry_run ]]; then
    printf 'Would publish branch %s and tags %s and v%s to origin\n' \
      "$branch" "$new_version" "$new_version"
    return
  fi

  git push origin "$branch"
  git push origin "$new_version" "v$new_version"
  printf 'Published branch %s and tags %s and v%s\n' \
    "$branch" "$new_version" "$new_version"
}

do_build_github() {
  require_new_version
  tag_points_to_head "$new_version"

  local branch run_id
  branch=$(git branch --show-current)
  [[ -n $branch ]] || die 'Cannot release from detached HEAD'

  if [[ -n $dry_run ]]; then
    printf 'Would run %s for version %s in %s\n' \
      "$release_workflow" "$new_version" "$release_repo"
    return
  fi

  git ls-remote --exit-code --tags origin \
    "refs/tags/$new_version" >/dev/null ||
    die "Tag $new_version is not available on origin"

  "$gh" workflow run "$release_workflow" \
    --repo "$release_repo" \
    --ref "$branch" \
    -f "version=$new_version"
  sleep 5
  run_id=$(
    "$gh" run list \
      --workflow "$release_workflow" \
      --repo "$release_repo" \
      --branch "$branch" \
      --event workflow_dispatch \
      --limit 1 \
      --json databaseId \
      --jq '.[0].databaseId'
  )
  [[ -n $run_id ]] || die 'Could not find the release workflow run'
  printf 'Watching release workflow run %s\n' "$run_id"
  "$gh" run watch "$run_id" \
    --repo "$release_repo" \
    --exit-status \
    --interval 10
}

do_rerun_failed_github() {
  local commit run_id
  commit=$(git rev-parse "$new_version^{commit}")
  run_id=$(
    "$gh" run list \
      --workflow "$release_workflow" \
      --repo "$release_repo" \
      --commit "$commit" \
      --event workflow_dispatch \
      --status failure \
      --limit 1 \
      --json databaseId \
      --jq '.[0].databaseId'
  )
  [[ -n $run_id ]] ||
    die "Could not find a failed release run for $new_version"
  printf 'Rerunning failed jobs from workflow run %s\n' "$run_id"
  "$gh" run rerun "$run_id" --repo "$release_repo" --failed
  "$gh" run watch "$run_id" \
    --repo "$release_repo" \
    --exit-status \
    --interval 10
}

do_retry() {
  require_new_version
  [[ $(current_version) == "$new_version" ]] ||
    die "Version files do not contain $new_version"

  local branch asset_count
  branch=$(git branch --show-current)
  [[ -n $branch ]] || die 'Cannot release from detached HEAD'
  git rev-parse "$new_version" >/dev/null 2>&1 ||
    die "Tag $new_version does not exist"
  git merge-base --is-ancestor "$new_version^{commit}" HEAD ||
    die "Tag $new_version is not an ancestor of HEAD"
  if [[ -z $dry_run && -n $(git status --porcelain) ]]; then
    git status --short >&2
    die 'Working tree is not clean'
  fi

  asset_count=$(
    "$gh" release view "$new_version" \
      --repo "$release_repo" \
      --json assets \
      --jq '.assets | length' 2>/dev/null || printf '0\n'
  )

  if [[ $asset_count == 0 ]]; then
    [[ $(git rev-parse "$new_version^{commit}") == $(git rev-parse HEAD) ]] ||
      die 'Go module tags are immutable; release a new version for new commits'
    tag_points_to_head "$new_version"
  fi

  if [[ -n $dry_run ]]; then
    if [[ $asset_count == 0 ]]; then
      printf 'Would publish branch %s and tags %s and v%s, then retry\n' \
        "$branch" "$new_version" "$new_version"
    else
      printf 'Would rerun failed jobs for release %s\n' "$new_version"
    fi
    return
  fi

  if [[ $asset_count != 0 ]]; then
    do_rerun_failed_github
    return
  fi

  do_push
  do_build_github
}

do_pull() {
  local before
  if ! git rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1; then
    printf 'No upstream branch configured; skipping pull\n'
    return
  fi
  before=$(git rev-parse HEAD)
  git pull --rebase
  [[ $(git rev-parse HEAD) == "$before" ]] ||
    die "New changes were pulled; rerun the release command"
}

do_release() {
  require_new_version
  do_sanity_check

  if [[ -n $dry_run ]]; then
    do_version_bump
    printf 'Would commit, tag, publish, and start the release workflow\n'
    return
  fi

  do_pull
  do_sanity_check

  if [[ $(current_version) != "$new_version" ]]; then
    confirm "Bump version to $new_version?" ||
      die 'Release stopped before the version bump'
    do_version_bump
  fi
  if [[ -n $(git status --porcelain -- \
      Makefile plugin.edn test/abi.c goyaml/plugin.go) ]]; then
    confirm "Commit version $new_version?" ||
      die 'Release stopped before the version commit'
    do_commit
  fi
  if ! git rev-parse "$new_version" >/dev/null 2>&1 ||
     ! git rev-parse "v$new_version" >/dev/null 2>&1; then
    confirm "Create tags $new_version and v$new_version?" ||
      die 'Release stopped before tag creation'
    do_tag
  fi
  if confirm "Publish the branch and tag to origin?"; then
    do_push
  fi
  if confirm 'Start and watch the GitHub release workflow?'; then
    do_build_github
  fi
}

case $command in
  list)
    do_list
    ;;
  sanity-check)
    do_sanity_check
    ;;
  version-bump)
    do_version_bump
    ;;
  pull)
    do_pull
    ;;
  commit)
    new_version=$old_version
    do_commit
    ;;
  tag)
    new_version=$old_version
    do_tag
    ;;
  push)
    new_version=$old_version
    do_push
    ;;
  build-github)
    new_version=$old_version
    do_build_github
    ;;
  retry)
    new_version=$old_version
    do_retry
    ;;
  release)
    do_release
    ;;
  *)
    die "Unknown release command: $command"
    ;;
esac
