#!/usr/bin/env bash

set -euo pipefail

archive=${1:?Usage: test-archive ARCHIVE PLATFORM VERSION}
platform=${2:?Usage: test-archive ARCHIVE PLATFORM VERSION}
version=${3:?Usage: test-archive ARCHIVE PLATFORM VERSION}
perl=${PERL:?PERL must name the project-managed Perl}

project_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
archive_dir=$(cd "$(dirname "$archive")" && pwd)
archive="$archive_dir/$(basename "$archive")"
release_name="yamlstar-plugin-parser-rapidyaml-$version-$platform"
work_dir=$(mktemp -d)
trap 'rm -rf "$work_dir"' EXIT

tar -xf "$archive" -C "$work_dir"
release_dir="$work_dir/$release_name"

case $platform in
  linux-*)
    extension=so
    link_flags=(-ldl -pthread)
    ;;
  macos-*)
    extension=dylib
    link_flags=(-pthread)
    ;;
  *)
    echo "Unsupported release platform: $platform" >&2
    exit 1
    ;;
esac

library_dir="$release_dir/lib"
library="$library_dir/libyamlstar-plugin-parser-rapidyaml.$extension"
manifest="$release_dir/share/yamlstar/plugins/rapidyaml/plugin.edn"

test -f "$library"
test -f "$manifest"
test -f "$release_dir/include/yamlstar/yamlstar_plugin.h"
test -f "$release_dir/License"
test -f "$release_dir/ReadMe.md"
cmp "$project_dir/plugin.edn" "$manifest"

read -r -a cc_command <<< "${CC:-cc}"
"${cc_command[@]}" \
  -Wall -Wextra -Werror \
  -I"$project_dir/include" \
  "-DPLUGIN_EXTENSION=\"$extension\"" \
  "-DPLUGIN_VERSION=\"$version\"" \
  "$project_dir/test/abi.c" \
  "${link_flags[@]}" \
  -o "$work_dir/abi-test"

YAMLSTAR_LIBRARY_PATH=$library_dir "$work_dir/abi-test"

description=$(file "$library")
case $platform in
  linux-x64)
    [[ $description == *x86-64* ]]
    ;;
  linux-aarch64)
    [[ $description == *aarch64* || $description == *ARM64* ]]
    ;;
  macos-x64)
    [[ $description == *x86_64* ]]
    ;;
  macos-arm64)
    [[ $description == *arm64* ]]
    ;;
esac

if [[ $platform == linux-* ]]; then
  # The dollar signs below are Perl variables, not shell expansions.
  # shellcheck disable=SC2016
  newer_glibc=$(
    readelf --version-info "$library" |
      "$perl" -ne '
        while (/Name: GLIBC_(\d+)\.(\d+)/g) {
          print "$1.$2\n"
            if $1 > 2 || ($1 == 2 && $2 > 28);
        }
      '
  )
  if [[ -n $newer_glibc ]]; then
    echo "Library requires glibc newer than 2.28:" >&2
    echo "$newer_glibc" >&2
    exit 1
  fi
else
  otool -L "$library"
fi

echo "Release archive test passed: $(basename "$archive")"
